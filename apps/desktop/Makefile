# Tracker Cycles desktop app (apps/desktop/PLAN.md).
#   make            build/tidal-desktop (needs libsdl2-dev)
#   make test       headless key sessions (tests/*.keys -> *.expected)
#   make run        build and open the window (run.sh)
#   make clean

CXX       ?= g++
CXXFLAGS  ?= -std=c++17 -O2 -g -Wall -Wextra -Wno-missing-field-initializers -Wno-format-truncation
TIDAL     := ../../tidal
TBUILD    := $(TIDAL)/build
BUILD     := build
SDL_CFLAGS := $(shell sdl2-config --cflags 2>/dev/null || echo -I/usr/include/SDL2 -D_REENTRANT)
SDL_LIBS   := $(shell sdl2-config --libs 2>/dev/null || echo -lSDL2)

SRC  := main.cpp keymap.cpp input.cpp
OBJ  := $(SRC:%.cpp=$(BUILD)/%.o) $(BUILD)/embed.o
LIBS := $(TBUILD)/libtidal_host.a $(TBUILD)/libtidal.a
INC  := -I$(TIDAL)/core -I$(TIDAL)/editor -I$(TIDAL)/host -I$(TIDAL)/../core/libs

.PHONY: all test run clean tidal-libs
all: $(BUILD)/tidal-desktop

# the shared code (tidal/core, tidal/editor, tidal/host); its own Makefile
# knows when to rebuild
tidal-libs:
	$(MAKE) -s -C $(TIDAL) lib

$(LIBS): tidal-libs

$(BUILD)/tidal-desktop: $(OBJ) $(LIBS)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJ) $(LIBS) $(SDL_LIBS) -pthread

$(BUILD)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(SDL_CFLAGS) $(INC) -MMD -MP -c -o $@ $<

# the default keymap and the GHCi boot script, compiled in
$(BUILD)/embed.cpp: keymaps/iso-uk.txt $(TIDAL)/proto/boot.ghci
	@mkdir -p $(dir $@)
	@{ echo '// generated by apps/desktop/Makefile'; \
	   echo 'namespace desk {'; \
	   echo 'extern const char* const kDefaultKeymap = R"TCEMBED('; cat keymaps/iso-uk.txt; echo ')TCEMBED";'; \
	   echo 'extern const char* const kBootTemplate = R"TCEMBED('; cat $(TIDAL)/proto/boot.ghci; echo ')TCEMBED";'; \
	   echo '}'; } > $@

$(BUILD)/embed.o: $(BUILD)/embed.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

test: $(BUILD)/tidal-desktop
	tests/run.sh $(BUILD)/tidal-desktop

run: $(BUILD)/tidal-desktop
	./run.sh

clean:
	rm -rf $(BUILD)

-include $(wildcard $(BUILD)/*.d)
