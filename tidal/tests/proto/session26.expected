msg: removed 4 steps
setcps (120/60/4)

-- kick and snare
d1 $ every 4 (fast 2) $ s "~" # gain 1

-- hats
d2 $ s "hh*8" # gain 0.8 # pan sine

d3 $ n "0 .. 7" # s "arpy" # speed "<1 2>"

-- MIDI channel 1
d9 $ n "c'maj e'min" # legato 0.5
