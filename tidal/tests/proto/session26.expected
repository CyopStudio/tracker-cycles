msg: 3 steps selected: Screen 3-7 wrap them, Delete removes, Copy copies
menu: (closed)
msg: [ ] (selection): [bd*2 [~ sd] bd]
setcps (120/60/4)

-- kick and snare
d1 $ every 4 (fast 2) $ s "[bd*2 [~ sd] bd] sd" # gain 1

-- hats
d2 $ s "hh*8" # gain 0.8 # pan sine

d3 $ n "0 .. 7" # s "arpy" # speed "<1 2>"

-- MIDI channel 1
d9 $ n "c'maj e'min" # legato 0.5
msg: 4 steps selected: Screen 3-7 wrap them, Delete removes, Copy copies
