> setcps (120/60/4)
> d2 $ s "hh*8" # gain 0.8 # pan sine
setcps (120/60/4)

-- kick and snare
d1 $ (inside 6 (ghost' 2) $ s "bd*2 [~ sd] bd sd" # gain 1) # voices 3

-- hats
d2 $ s "hh*8" # gain 0.8 # pan sine

d3 $ n "0 .. 7" # s "arpy" # speed "<1 2>"

-- MIDI channel 1
d9 $ n "c'maj e'min" # legato 0.5
