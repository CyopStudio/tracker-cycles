> setcps (120/60/4)
> jumpMod 1 4 $ every 4 (fast 2) $ s "bd*2 [~ sd] bd sd" # gain 1
> jumpIn 9 2 $ (n "c'maj e'min" # legato 0.5) |< s "midi" |< midichan 0
> d2 $ s "hh*8" # gain 0.8 # pan sine
> d1 $ every 4 (fast 2) $ s "bd*2 [~ sd] bd sd" # gain 1
setcps (120/60/4)

-- kick and snare
d1 $ every 4 (fast 2) $ s "bd*2 [~ sd] bd sd" # gain 1

-- hats
d2 $ s "hh*8" # gain 0.8 # pan sine

d3 $ n "0 .. 7" # s "arpy" # speed "<1 2>"

-- MIDI channel 1
jumpIn 9 2 $ n "c'maj e'min" # legato 0.5
