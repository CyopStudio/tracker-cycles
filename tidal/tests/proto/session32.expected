setcps (120/60/4)

-- kick and snare
d1 $ s "bd*2 ~ sd bd sd"

-- hats
d2 $ s "hh*8" # (slow 2 $ gain 0.8) # pan sine

d3 $ n "0 .. 7" # s "arpy" # speed "<1 2>"

-- MIDI channel 1
d9 $ n "c'maj e'min" # legato 0.5
