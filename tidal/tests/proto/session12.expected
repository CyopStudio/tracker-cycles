msg: ERROR inside "..." only
menu insert [ ]: [insert [hh*8 hh*8]] [insert [hh*8 hh*8 hh*8]] [insert [hh*8, hh*8]]
menu < >: [<[hh*8 hh*8 hh*8]>] [<[hh*8 hh*8 hh*8] ~>] [<[hh*8 hh*8 hh*8] [hh*8 hh*8 hh*8]>]
menu { }: [{[hh*8 hh*8 hh*8]}%4] [{[hh*8 hh*8 hh*8] [hh*8 hh*8 hh*8] [hh*8 hh*8 hh*8]}%4] [{[hh*8 hh*8 hh*8], [hh*8 hh*8 hh*8] [hh*8 hh*8 hh*8] [hh*8 hh*8 hh*8]}]
menu ( , ): [[hh*8 hh*8 hh*8](3,8)] [[hh*8 hh*8 hh*8](5,8)] [[hh*8 hh*8 hh*8](3,8,2)] [[hh*8 hh*8 hh*8](<3 5>,8)]
menu |: [[[hh*8 hh*8 hh*8](3,8) | ~]] [[[hh*8 hh*8 hh*8](3,8) | [hh*8 hh*8 hh*8](3,8)]] [[[hh*8 hh*8 hh*8](3,8) | [hh*8 hh*8 hh*8](3,8) | ~]]
setcps (120/60/4)

-- kick and snare
d1 $ (hurry 2 $ every 4 (fast 2) $ s "bd*2 [~ sd] bd sd" # gain 1) # gain 1

-- hats
d2 $ s "[hh*8 hh*8 hh*8](3,8) hh*8" # gain 0.8 # pan sine

d3 $ n "0 .. 7" # s "arpy" # speed "<1 2>"

-- MIDI channel 1
d9 $ n "c'maj e'min" # legato 0.5
