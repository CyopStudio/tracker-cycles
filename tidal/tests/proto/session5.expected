> setcps (120/60/4)
> d3 $ n ("0 .. 7" |* 2) # s "arpy" # speed "<1 2>"
setcps (120/60/4)

-- kick and snare
d1 $ 0.26 <~ ((every 4 (fast 2) $ s "<bd(4,8)*2> [~ sd] bd sd" # gain 1) |+ n 11)

-- hats
d2 $ s "hh*8" # gain 0.8 # pan sine # pan sine # pan sine

d3 $ n ("0 .. 7" |* 2) # s "arpy" # speed "<1 2>"

-- MIDI channel 1
d9 $ n "c'maj e'min" # legato 0.5
