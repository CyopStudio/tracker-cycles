-- Tracker Cycles prototype boot script (our own; not Tidal's BootTidal.hs).
-- Set oAddress to where SuperDirt runs: the WSL default gateway with NAT
-- networking (ip route show default | awk '{print $3}'), or 127.0.0.1 in
-- mirrored mode or when SuperDirt runs in the same machine/VM.
:set -XOverloadedStrings
:set prompt ""
:set prompt-cont ""
import Sound.Tidal.Context

tidal <- startTidal (superdirtTarget {oAddress = "127.0.0.1", oPort = 57120, oLatency = 0.1}) defaultConfig

:{
let p = streamReplace tidal
    hush = streamHush tidal
    once = streamOnce tidal
    setcps = once . cps
    d1 = p 1
    d2 = p 2
    d3 = p 3
    d4 = p 4
    d5 = p 5
    d6 = p 6
    d7 = p 7
    d8 = p 8
    d9 = p 9
    d10 = p 10
    d11 = p 11
    d12 = p 12
    d13 = p 13
    d14 = p 14
    d15 = p 15
    d16 = p 16
    -- transitions, as in Tidal's BootTidal.hs: jumpMod 1 4 $ ... switches d1
    -- at the next multiple of 4 cycles, jumpIn 1 2 $ ... two cycles after
    -- the next cycle start
    jumpMod i t = transition tidal True (Sound.Tidal.Context.jumpMod t) i
    jumpIn i t = transition tidal True (Sound.Tidal.Context.jumpIn t) i
:}
